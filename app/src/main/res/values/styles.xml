<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Overlay for HTC Sense light: HtcDeviceDefault inherits Holo dark text colours,
         which wash out on Sense's light common_app_bkg. Applied with Theme.applyStyle(). -->
    <style name="SenseLightText">
        <item name="android:textColorPrimary">#FF252525</item>
        <item name="android:textColorSecondary">#FF6B6B6B</item>
        <item name="android:textColorTertiary">#FF8A8A8A</item>
        <item name="android:textColorHint">#FF9A9A9A</item>
    </style>

</resources>
