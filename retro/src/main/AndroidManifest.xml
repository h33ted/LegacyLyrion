<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.h33ted.legacylyrion.retro">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- the current track's artwork for the Galaxy S lock screen (it only reads art from MediaStore) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- 240x320 phones (X10 mini, X8 at 120 dpi) up to 320x480 and bigger -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="LegacyLyrion Retro"
        android:theme="@android:style/Theme.NoTitleBar">

        <activity
            android:name=".HomeActivity"
            android:label="LegacyLyrion"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NowPlayingActivity"
            android:label="Now playing"
            android:launchMode="singleTop" />

        <activity
            android:name=".BrowseActivity"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".QueueActivity"
            android:label="Play queue"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".SetupActivity"
            android:label="Find your Lyrion server"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:configChanges="orientation|keyboardHidden" />

        <receiver android:name=".MediaButtonReceiver">
            <intent-filter android:priority="900">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.AUDIO_BECOMING_NOISY" />
            </intent-filter>
        </receiver>

        <!-- the phone player's track, for the Galaxy S lock screen (read-only, no personal data) -->
        <provider
            android:name=".NowPlayingProvider"
            android:authorities="com.h33ted.legacylyrion.retro.nowplaying"
            android:exported="true" />

        <service
            android:name=".SlimProtoService"
            android:exported="false" />
    </application>
</manifest>
